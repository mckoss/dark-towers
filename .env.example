# Railway / production environment.
# SETTINGS_JSON is the ONLY app setting: paste the full contents of settings.json
# (api_key, admins, google client, session_secret, public_origin) as its value.
SETTINGS_JSON={"api_key":"...","admins":["mckoss@gmail.com","kstoltz@citynetwork.com"],"google":{"client_id":"...","client_secret":"..."},"session_secret":"...","public_origin":"https://..."}
DATA_DIR=/data          # mount a Railway volume here
PORT=3000
SCHEDULER=on            # 'off' disables the hourly nightly-capture job
